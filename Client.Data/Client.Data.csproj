<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ClientDataTargetFramework>net10.0</ClientDataTargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TargetFramework>$(ClientDataTargetFramework)</TargetFramework>
    <AssemblyName>Client.Data</AssemblyName>
    <RootNamespace>Client.Data</RootNamespace>
    <UseSourceGenerators>true</UseSourceGenerators>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="BouncyCastle.NetCore" Version="2.2.1" />
    <PackageReference Include="cryptopp" Version="5.6.5.4" />
    <PackageReference Include="Delizious.Ini" Version="1.23.0" />
    <PackageReference Include="LEA.NET" Version="1.0.1.1" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>
</Project>
