<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ClientMainTargetFramework Condition="'$(ClientMainTargetFramework)' == ''">net10.0</ClientMainTargetFramework>
    <ClientMainTargetFramework Condition="'$(MonoGameFramework)' == 'MonoGame.Framework.Android'">net10.0-android</ClientMainTargetFramework>
    <ClientMainTargetFramework Condition="'$(MonoGameFramework)' == 'MonoGame.Framework.WindowsDX'">net10.0-windows</ClientMainTargetFramework>
    <TargetFramework>$(ClientMainTargetFramework)</TargetFramework>
    <AssemblyName>Client.Main</AssemblyName>
    <RootNamespace>Client.Main</RootNamespace>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseSourceGenerators>true</UseSourceGenerators>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MonoGameFramework)' == 'MonoGame.Framework.WindowsDX'">
    <DefineConstants>$(DefineConstants);WINDOWS_DX</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MonoGamePlatform)' == 'WindowsDX12'">
    <DefineConstants>$(DefineConstants);WINDOWS_DX;WINDOWS_DX12;NATIVE_BACKEND</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MonoGamePlatform)' == 'DesktopVK'">
    <DefineConstants>$(DefineConstants);DESKTOP_VK;NATIVE_BACKEND</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pipelines.Sockets.Unofficial" Version="2.2.16" />
    <PackageReference Include="MUnique.OpenMU.Network" Version="0.9.8" />
    <PackageReference Include="MUnique.OpenMU.Network.Packets" Version="0.9.8" ExcludeAssets="contentFiles" />
    <PackageReference Include="NLayer" Version="1.16.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android' AND '$(MonoGameFramework)' == 'MonoGame.Framework.Native'">
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android' AND '$(MonoGameFramework)' == 'MonoGame.Framework.WindowsDX'">
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android' AND '$(MonoGameFramework)' != 'MonoGame.Framework.Native' AND '$(MonoGameFramework)' != 'MonoGame.Framework.WindowsDX'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Controls\UI\Game\Layouts\*.json" />
    <EmbeddedResource Include="Data\S6\item.bmd" />
    <EmbeddedResource Include="Data\S6\mix.bmd" />
    <EmbeddedResource Include="Data\S6\movereq_eng.bmd" />
    <EmbeddedResource Include="Data\S6\player.bmd" />
    <EmbeddedResource Include="Data\S6\skill_eng.bmd" />
    <EmbeddedResource Include="Data\bmd_blending_config.json" />
    <EmbeddedResource Include="..\data\patch\files-e.g\Interface\**\*">
      <LogicalName>BundledUi/Interface/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Data\Client.Data.csproj" />
    <ProjectReference Include="..\Client.Telemetry\Client.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
