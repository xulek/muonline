# Content manifest of the Android head (MuAndroid.csproj).
#
# Same content as Content.mgcb, except that DynamicLighting, ItemMaterial and MonsterMaterial are built from
# the simplified OpenGL ES variants in Android/ under their usual asset names. Keep both manifests in sync
# when adding or removing content.

#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:Android
/config:
/profile:HiDef
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin AlphaRGB.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Optimize
/build:AlphaRGB.fx

#begin GrassShadow.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Optimize
/build:GrassShadow.fx

#begin HudOrb.fx
