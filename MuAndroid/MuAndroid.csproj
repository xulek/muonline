<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <TargetPlatformVersion>36.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <ClientMainTargetFramework>net10.0-android</ClientMainTargetFramework>
    <MonoGameFramework>MonoGame.Framework.Android</MonoGameFramework>
    <!-- NuGet's legacy project walk drops ProjectReference.AdditionalProperties. -->
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <NoWarn>$(NoWarn);XA0141;XA4211</NoWarn>

    <OutputType>Exe</OutputType>
    <ApplicationId>MuMono.MuMono</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <MonoGamePlatform>Android</MonoGamePlatform>
    <UseSourceGenerators>true</UseSourceGenerators>

    <!-- Keep normal local Release builds configurable. -->
    <AndroidPerformanceRelease Condition="'$(AndroidPerformanceRelease)' == '' AND '$(Configuration)' == 'Release'">true</AndroidPerformanceRelease>
    <AndroidFullAot Condition="'$(AndroidFullAot)' == ''">true</AndroidFullAot>
    <AndroidUseLlvm Condition="'$(AndroidUseLlvm)' == ''">$(AndroidFullAot)</AndroidUseLlvm>
    <AndroidPackageFormats Condition="'$(AndroidPackageFormats)' == ''">apk</AndroidPackageFormats>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(AndroidPerformanceRelease)' == 'true'">android-arm64</RuntimeIdentifier>

    <!-- Release packages must contain assemblies and must never use Fast Deployment. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
  </PropertyGroup>

  <!-- Explicit compatibility profile for local troubleshooting and emulator builds. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(AndroidPerformanceRelease)' != 'true'">
    <RunAOTCompilation>false</RunAOTCompilation>
    <EnableLLVM>false</EnableLLVM>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!--
    Maximum runtime-performance profile for physical ARM64 devices.
    Full AOT + LLVM increases build time and package size, but removes JIT work from gameplay.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(AndroidPerformanceRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);ANDROID_PERFORMANCE_RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot Condition="'$(AndroidFullAot)' == 'true'">false</AndroidEnableProfiledAot>
    <AndroidEnableProfiledAot Condition="'$(AndroidFullAot)' != 'true'">true</AndroidEnableProfiledAot>
    <AndroidUseDefaultAotProfile>true</AndroidUseDefaultAotProfile>
    <AndroidAotEnableLazyLoad>true</AndroidAotEnableLazyLoad>
    <EnableLLVM>$(AndroidUseLlvm)</EnableLLVM>
    <AndroidEnableMarshalMethods>$(AndroidUseLlvm)</AndroidEnableMarshalMethods>

    <!-- AOT requires trimming. SdkOnly protects reflection-driven game assemblies. -->
    <PublishTrimmed>true</PublishTrimmed>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidCreateProguardMappingFile>true</AndroidCreateProguardMappingFile>

    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <AndroidStripNativeLibraries>true</AndroidStripNativeLibraries>
    <UseInterpreter>false</UseInterpreter>

    <!-- Favor stable frame pacing over peak collector throughput. -->
    <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
    <AndroidEnablePreloadAssemblies>false</AndroidEnablePreloadAssemblies>

    <!-- Remove diagnostic runtime components from the shipping package. -->
    <EnableDiagnostics>false</EnableDiagnostics>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>

    <AndroidSdkBuildToolsVersion>36.0.0</AndroidSdkBuildToolsVersion>
    <JavaMaximumHeapSize>4G</JavaMaximumHeapSize>
    <JavaOptions>-XX:+UseParallelGC -Dfile.encoding=UTF-8</JavaOptions>
    <MonoGameMGCBAdditionalArguments>/config:Release</MonoGameMGCBAdditionalArguments>
  </PropertyGroup>

  <PropertyGroup>
    <_MGCBRidSuffix Condition="'$(RuntimeIdentifier)' != ''">/$(RuntimeIdentifier)</_MGCBRidSuffix>
    <_MGCBRidSuffix Condition="'$(RuntimeIdentifier)' == ''"></_MGCBRidSuffix>
  </PropertyGroup>

  <Target Name="PatchMGCBPaths" AfterTargets="CollectContentReferences" Condition="'$(MonoGamePlatform)' == 'Android'">
    <ItemGroup>
      <ContentReference Update="@(ContentReference)">
        <ContentIntermediateOutputDir>%(ContentReference.FullDir)obj/$(MonoGamePlatform)/$(TargetFramework)$(_MGCBRidSuffix)/%(ContentReference.OutputFolder)</ContentIntermediateOutputDir>
        <ContentOutputDir>%(ContentReference.FullDir)bin/$(MonoGamePlatform)$(_MGCBRidSuffix)/%(ContentReference.OutputFolder)</ContentOutputDir>
      </ContentReference>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.5" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\Client.Main\MGContent\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
    </MonoGameContentReference>
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\Client.Main\appsettings.json">
      <Link>appsettings.json</Link>
    </AndroidAsset>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Data\Client.Data.csproj" />
    <ProjectReference Include="..\Client.Main\Client.Main.csproj"
                      AdditionalProperties="ClientMainTargetFramework=net10.0-android;MonoGameFramework=MonoGame.Framework.Android" />
  </ItemGroup>

  <!-- Local-build convenience. CI restores tools once and disables this target. -->
  <Target Name="RestoreDotnetTools"
          BeforeTargets="RunContentBuilder"
          Condition="'$(RestoreMonoGameTools)' != 'false' AND '$(DesignTimeBuild)' != 'true'">
    <Message Text="Restoring MonoGame tools" Importance="High" />
    <Exec Command="dotnet tool restore --tool-manifest &quot;$(MSBuildProjectDirectory)\.config\dotnet-tools.json&quot;" />
  </Target>

  <Target Name="ValidateAndroidPerformanceRelease"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' AND '$(AndroidPerformanceRelease)' == 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != 'android-arm64'"
           Text="AndroidPerformanceRelease requires RuntimeIdentifier=android-arm64." />
    <Error Condition="$([System.String]::Copy('$(RunAOTCompilation)').ToLowerInvariant()) != 'true'"
           Text="AndroidPerformanceRelease requires RunAOTCompilation=true." />
    <Error Condition="$([System.String]::Copy('$(PublishTrimmed)').ToLowerInvariant()) != 'true'"
           Text="Android AOT requires PublishTrimmed=true." />
    <Error Condition="'$(AndroidLinkMode)' != 'SdkOnly'"
           Text="AndroidPerformanceRelease requires AndroidLinkMode=SdkOnly to preserve reflection-driven game code." />
    <Message Importance="High"
             Text="Android performance profile: RID=$(RuntimeIdentifier), FullAOT=$(AndroidFullAot), LLVM=$(EnableLLVM), Packages=$(AndroidPackageFormats)" />
  </Target>
</Project>
