<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <MonoGamePlatform>Windows</MonoGamePlatform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ClientMainTargetFramework>net10.0-windows</ClientMainTargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RollForward>LatestPatch</RollForward>

    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <AssemblyName>MuMono</AssemblyName>
    <UseSourceGenerators>true</UseSourceGenerators>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(PerformanceRelease)' == 'true'">
    <!-- Folder publish avoids single-file bundle/extraction and compression overhead. -->
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- R2R removes first-use JIT stalls; Tiered PGO replaces hot R2R methods later. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <PublishReadyToRunEmitSymbols>false</PublishReadyToRunEmitSymbols>

    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <MonoGameMGCBAdditionalArguments>/config:Release</MonoGameMGCBAdditionalArguments>
  </PropertyGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\Client.Main\MGContent\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
    </MonoGameContentReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Main\Client.Main.csproj"
                      AdditionalProperties="MonoGameFramework=MonoGame.Framework.WindowsDX;TargetFramework=$(ClientMainTargetFramework)" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' AND '$(PerformanceRelease)' == 'true'">
    <None Include="appsettings.performance.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="RestoreDotnetTools"
          BeforeTargets="RunContentBuilder"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(RestoreMonoGameTools)' != 'false'">
    <Message Text="Restoring MonoGame tools" Importance="High" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="dotnet tool restore" />
  </Target>

  <Target Name="ValidatePerformancePublish"
          BeforeTargets="Publish"
          Condition="'$(Configuration)' == 'Release' AND '$(PerformanceRelease)' == 'true'">
    <Error Condition="'$(PublishTrimmed)' == 'true'"
           Text="Performance Release does not support trimming because runtime reflection is used by scene, world, NPC and skill registries." />
    <Error Condition="'$(PublishAot)' == 'true'"
           Text="Performance Release does not support NativeAOT until all reflection-driven registries are converted to generated registries." />
    <Error Condition="'$(PublishSingleFile)' == 'true'"
           Text="Performance Release intentionally uses a folder publish. Single-file bundling is a distribution option, not a frame-time optimization." />
  </Target>
</Project>
